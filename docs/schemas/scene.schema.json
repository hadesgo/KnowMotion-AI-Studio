{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowmotion.local/schemas/scene.schema.json",
  "title": "KnowMotion Scene",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sceneId",
    "order",
    "title",
    "narration",
    "durationMs",
    "layout",
    "layers",
    "assetRefs",
    "subtitleIds"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "sceneId": {
      "type": "string",
      "format": "uuid"
    },
    "order": {
      "type": "integer",
      "minimum": 0
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "narration": {
      "type": "string",
      "maxLength": 5000
    },
    "durationMs": {
      "type": "integer",
      "minimum": 100,
      "maximum": 600000
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "background"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 256
        },
        "height": {
          "type": "integer",
          "minimum": 256
        },
        "background": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^(#[0-9a-fA-F]{6}|#[0-9a-fA-F]{8})$"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "assetId"
              ],
              "properties": {
                "assetId": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        }
      }
    },
    "layers": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/layer"
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keyframes"
      ],
      "properties": {
        "keyframes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "atMs",
              "scale",
              "x",
              "y",
              "easing"
            ],
            "properties": {
              "atMs": {
                "type": "integer",
                "minimum": 0
              },
              "scale": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "easing": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "transitionIn": {
      "$ref": "#/$defs/transition"
    },
    "transitionOut": {
      "$ref": "#/$defs/transition"
    },
    "assetRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "subtitleIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "durationMs"
      ],
      "properties": {
        "type": {
          "enum": [
            "fade",
            "slide",
            "wipe",
            "scale",
            "none"
          ]
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "direction": {
          "enum": [
            "left",
            "right",
            "up",
            "down"
          ]
        }
      }
    },
    "commonLayer": {
      "type": "object",
      "required": [
        "layerId",
        "type",
        "fromMs",
        "toMs"
      ],
      "properties": {
        "layerId": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string"
        },
        "fromMs": {
          "type": "integer",
          "minimum": 0
        },
        "toMs": {
          "type": "integer",
          "minimum": 1
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0
        },
        "rotation": {
          "type": "number"
        },
        "motion": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "layer": {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/commonLayer"
            },
            {
              "type": "object",
              "required": [
                "type",
                "text"
              ],
              "properties": {
                "type": {
                  "const": "text"
                },
                "text": {
                  "type": "string",
                  "maxLength": 5000
                },
                "fontToken": {
                  "type": "string"
                },
                "color": {
                  "type": "string"
                },
                "fontSize": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "align": {
                  "enum": [
                    "left",
                    "center",
                    "right"
                  ]
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/commonLayer"
            },
            {
              "type": "object",
              "required": [
                "type",
                "assetId"
              ],
              "properties": {
                "type": {
                  "const": "image"
                },
                "assetId": {
                  "type": "string"
                },
                "fit": {
                  "enum": [
                    "cover",
                    "contain",
                    "fill"
                  ]
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/commonLayer"
            },
            {
              "type": "object",
              "required": [
                "type",
                "shape"
              ],
              "properties": {
                "type": {
                  "const": "shape"
                },
                "shape": {
                  "enum": [
                    "rectangle",
                    "circle",
                    "line",
                    "arrow"
                  ]
                },
                "fill": {
                  "type": "string"
                },
                "stroke": {
                  "type": "string"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/commonLayer"
            },
            {
              "type": "object",
              "required": [
                "type",
                "assetId"
              ],
              "properties": {
                "type": {
                  "const": "video"
                },
                "assetId": {
                  "type": "string"
                },
                "startAtMs": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/commonLayer"
            },
            {
              "type": "object",
              "required": [
                "type",
                "chartType",
                "data"
              ],
              "properties": {
                "type": {
                  "const": "chart"
                },
                "chartType": {
                  "enum": [
                    "bar",
                    "line",
                    "pie"
                  ]
                },
                "data": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/commonLayer"
            },
            {
              "type": "object",
              "required": [
                "type",
                "children"
              ],
              "properties": {
                "type": {
                  "const": "group"
                },
                "children": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/layer"
                  }
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/commonLayer"
            },
            {
              "type": "object",
              "required": [
                "type",
                "preset"
              ],
              "properties": {
                "type": {
                  "const": "particle"
                },
                "preset": {
                  "type": "string"
                },
                "intensity": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          ]
        }
      ]
    }
  }
}

