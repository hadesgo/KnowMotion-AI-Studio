{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowmotion.local/schemas/project.schema.json",
  "title": "KnowMotion Project Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "name",
    "metadata",
    "production",
    "documents",
    "assetManifest",
    "workflow",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "projectId": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topic",
        "contentType",
        "audience",
        "language",
        "visualStyle"
      ],
      "properties": {
        "topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "contentType": {
          "enum": [
            "knowledge",
            "science",
            "technology",
            "history",
            "nature",
            "ai"
          ]
        },
        "audience": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 35
        },
        "visualStyle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "production": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetDurationSec",
        "aspectRatio",
        "width",
        "height",
        "fps"
      ],
      "properties": {
        "targetDurationSec": {
          "type": "integer",
          "minimum": 5,
          "maximum": 3600
        },
        "aspectRatio": {
          "enum": [
            "16:9",
            "9:16",
            "1:1"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 256,
          "maximum": 7680,
          "multipleOf": 2
        },
        "height": {
          "type": "integer",
          "minimum": 256,
          "maximum": 7680,
          "multipleOf": 2
        },
        "fps": {
          "enum": [
            24,
            25,
            30,
            50,
            60
          ]
        }
      }
    },
    "documents": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outline",
        "narration",
        "storyboard",
        "timeline"
      ],
      "properties": {
        "outline": {
          "$ref": "#/$defs/documentRef"
        },
        "narration": {
          "$ref": "#/$defs/documentRef"
        },
        "storyboard": {
          "$ref": "#/$defs/documentRef"
        },
        "timeline": {
          "$ref": "#/$defs/documentRef"
        }
      }
    },
    "assetManifest": {
      "$ref": "#/$defs/documentRef"
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currentStage",
        "approvals"
      ],
      "properties": {
        "runId": {
          "type": "string",
          "format": "uuid"
        },
        "currentStage": {
          "type": "string",
          "minLength": 1
        },
        "approvals": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "pending",
              "approved",
              "changes_requested"
            ]
          }
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "documentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "schemaVersion",
        "revision",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "schemaVersion": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}

